# ============================================================================
# Juntos Siempre — Variables de entorno
# ----------------------------------------------------------------------------
# Copia este archivo como ".env" y rellena los dos valores.
# El archivo ".env" NO se sube al repositorio (está en .gitignore).
#
# Dónde encontrarlos:
#   Supabase -> tu proyecto -> Project Settings -> API
#     · "Project URL"        -> VITE_SUPABASE_URL
#     · "anon" / "public"    -> VITE_SUPABASE_ANON_KEY
#
# IMPORTANTE: aquí solo va la clave PÚBLICA (anon).
# La clave "service_role" NUNCA debe usarse en la web ni guardarse aquí.
# ============================================================================

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_PUBLICA_ANON

# Opcional: nombre del contenedor de imágenes. Por defecto "site-media".
# VITE_SUPABASE_BUCKET=site-media
